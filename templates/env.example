# .env.example — copy to .env and fill in. Never commit .env.
# Superuser used by the container entrypoint (bootstrap runs as this user)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=app
DB_PORT=5432

# Environment name. The dev seed only runs when this is development, local or test.
APP_ENV=development

# Login roles created by database/security/roles.sql
DB_OWNER_PASSWORD=
DB_API_PASSWORD=
DB_WORKER_PASSWORD=
DB_READONLY_PASSWORD=

# Used by "build migrate" without --docker (owner role, so new objects get the right owner)
DATABASE_URL=postgresql://app_owner:password@localhost:5432/app
